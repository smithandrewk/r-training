scale_color_manual(values = c("Trend" = "blue", "Seasonal" = "green", "Remainder" = "red"))
forecast_df %>% autoplot()
# Combine observed and forecasted components
plot_df <- decomposition %>%
select(epiweek, trend, seasonal, random) %>%
bind_rows(forecast_df %>% select(epiweek, trend, seasonal, random)) %>%
pivot_longer(cols = c(trend, seasonal, random), names_to = "component", values_to = "value")
library(feasts)
library(tsibble)
library(ggplot2)
library(dplyr)
# Combine observed and forecasted components
plot_df <- decomposition %>%
select(epiweek, trend, seasonal, random) %>%
bind_rows(forecast_df %>% select(epiweek, trend, seasonal, random)) %>%
pivot_longer(cols = c(trend, seasonal, random), names_to = "component", values_to = "value")
# Plot with faceting
ggplot(plot_df, aes(x = epiweek, y = value)) +
geom_line(size = 1) +
facet_wrap(~ component, ncol = 1, scales = "free_y") +
labs(
title = "Decomposition Components with Forecast",
x = "Epidemiological Week",
y = "Value"
) +
theme_minimal() +
theme(strip.text = element_text(face = "bold", size = 12))
