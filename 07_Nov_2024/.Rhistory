# Decompose the time series
decomp <- counts %>%
model(classical_decomposition(case, type = "multiplicative")) %>%
components()
# Add numeric index for modeling
decomp <- decomp %>%
mutate(numeric_index = as.numeric(row_number()))
# Model the trend component
trend_model <- lm(trend ~ numeric_index, data = decomp)
future_index <- max(decomp$numeric_index) + seq_len(10)
future_trend <- predict(trend_model, newdata = data.frame(numeric_index = future_index))
# Predict the seasonal component
seasonality <- decomp$seasonal
future_seasonality <- rep(seasonality, length.out = 10)
# Forecast the total cases as the sum of trend and seasonal components
forecast_cases <- future_trend * future_seasonality
# Prepare the forecast data frame
forecast_df <- tibble(
epiweek = seq(max(counts$epiweek) + 1, length.out = 10, by = 1),
case = forecast_cases
)
# Combine observed and forecasted case counts
case_df <- counts %>%
select(epiweek, case) %>%
bind_rows(forecast_df)
# Plot observed and forecasted case counts
ggplot(case_df, aes(x = epiweek, y = case)) +
geom_line(color = "black", size = 1) +
geom_line(data = forecast_df, aes(x = epiweek, y = case), color = "red", size = 1) +
labs(
title = "Pertussis Cases with Forecast",
x = "Epidemiological Week",
y = "Case Count"
) +
theme_minimal()
# Decompose the time series
decomp <- counts %>%
model(classical_decomposition(case, type = "multiplicative")) %>%
components()
# Add numeric index for modeling
decomp <- decomp %>%
mutate(numeric_index = as.numeric(row_number()))
# Model the trend component
trend_model <- lm(trend ~ numeric_index, data = decomp)
future_index <- max(decomp$numeric_index) + seq_len(10)
future_trend <- predict(trend_model, newdata = data.frame(numeric_index = future_index), se.fit = TRUE)
# Extract trend predictions and standard error
future_trend_values <- future_trend$fit
future_trend_se <- future_trend$se.fit
# Predict the seasonal component
seasonality <- decomp$seasonal
future_seasonality <- rep(seasonality, length.out = 10)
# Forecast the total cases as the sum of trend and seasonal components
forecast_cases <- future_trend_values * future_seasonality
# Calculate confidence intervals (95%)
ci_upper <- (future_trend_values + 1.96 * future_trend_se) * future_seasonality
ci_lower <- (future_trend_values - 1.96 * future_trend_se) * future_seasonality
# Prepare the forecast data frame
forecast_df <- tibble(
epiweek = seq(max(counts$epiweek) + 1, length.out = 10, by = 1),
case = forecast_cases,
lower = ci_lower,
upper = ci_upper
)
# Combine observed and forecasted case counts
case_df <- counts %>%
select(epiweek, case) %>%
bind_rows(forecast_df %>% select(epiweek, case))
# Plot observed and forecasted case counts with confidence intervals
ggplot() +
geom_line(data = case_df, aes(x = epiweek, y = case), color = "black", size = 1) +
geom_line(data = forecast_df, aes(x = epiweek, y = case), color = "red", size = 1) +
geom_ribbon(data = forecast_df, aes(x = epiweek, ymin = lower, ymax = upper), fill = "red", alpha = 0.2) +
labs(
title = "Pertussis Cases with Forecast and Confidence Interval",
x = "Epidemiological Week",
y = "Case Count"
) +
theme_minimal()
# Filter observed data for the current year
current_year <- year(Sys.Date())
