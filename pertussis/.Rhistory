# Step 3: Resample the data to monthly totals
linelist_monthly <- linelist %>%
mutate(month = floor_date(datetime, "month")) %>%  # Floor to the start of each month
group_by(month) %>%
summarize(cases = sum(cases, na.rm = TRUE))
