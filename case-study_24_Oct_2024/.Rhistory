# Load necessary libraries
library(mlbench)
library(dplyr)
# Load the dataset
data("PimaIndiansDiabetes2")
# View the structure of the data
str(PimaIndiansDiabetes2)
# View the first few rows
head(PimaIndiansDiabetes2)
# Impute missing values (e.g., using median imputation)
PimaIndiansDiabetes2 <- PimaIndiansDiabetes2 %>%
mutate(across(everything(), ~ ifelse(is.na(.), median(., na.rm = TRUE), .)))
# Check for any remaining missing values
any(is.na(PimaIndiansDiabetes2))
# Descriptive statistics
summary(PimaIndiansDiabetes2)
# Count of diabetic vs. non-diabetic individuals
table(PimaIndiansDiabetes2$diabetes)
# Load ggplot2 for visualization
library(ggplot2)
# Convert diabetes to a factor for visualizations
PimaIndiansDiabetes2$diabetes <- as.factor(PimaIndiansDiabetes2$diabetes)
# 1. Histogram of glucose levels
ggplot(PimaIndiansDiabetes2, aes(x=glucose)) +
geom_histogram(binwidth = 10, fill = "steelblue", color = "white") +
labs(title = "Distribution of Glucose Levels")
# 2. Boxplot of number of pregnancies grouped by diabetes status
ggplot(PimaIndiansDiabetes2, aes(x=diabetes, y=pregnant)) +
geom_boxplot() +
labs(title = "Pregnancies by Diabetes Status", x="Diabetes", y="Pregnancies")
# 3. Boxplot of insulin levels grouped by diabetes status
ggplot(PimaIndiansDiabetes2, aes(x=diabetes, y=insulin)) +
geom_boxplot() +
labs(title = "Insulin by Diabetes Status", x="Diabetes", y="Insulin")
# Explore relationship between high glucose and insulin levels with diabetes status
PimaIndiansDiabetes2 %>%
filter(glucose > 150) %>%
count(diabetes)
# Combine glucose and insulin filter
PimaIndiansDiabetes2 %>%
filter(insulin > 150) %>%
filter(glucose > 150) %>%
count(diabetes)
# Train a decision tree model with the rpart package
library(rpart)
library(rpart.plot)
# Fit a decision tree classifier
clf <- rpart(diabetes ~ glucose + insulin + mass + pregnant + pressure + triceps + age + pedigree,
data = PimaIndiansDiabetes2, method = "class")
# Visualize the decision tree
rpart.plot(clf)
# Evaluate the model
X <- PimaIndiansDiabetes2[c('glucose','insulin','mass','pregnant','pressure','triceps','age','pedigree')]
y_true <- PimaIndiansDiabetes2$diabetes
y_pred <- predict(clf, X, type = "class")
# Compute accuracy
accuracy <- sum(y_true == y_pred, na.rm=TRUE) / length(y_true)
print(paste("Accuracy:", round(accuracy, 3)))
# Confusion matrix
library(caret)
conf_matrix <- confusionMatrix(y_pred, y_true)
print(conf_matrix)
# ROC curve analysis
library(pROC)
y_prob <- predict(clf, X, type = "prob")[,2] # Get probabilities for class '1'
roc_curve <- roc(y_true, y_prob)
plot(roc_curve, col = "blue", main = "ROC Curve for Diabetes Classification")
auc(roc_curve)  # Calculate Area Under the Curve (AUC)
# Load the corrplot library for correlation visualization
library(corrplot)
# Calculate the correlation matrix for the numeric variables
cor_matrix <- cor(PimaIndiansDiabetes2 %>% select_if(is.numeric), use = "complete.obs")
# Create a correlation heatmap
corrplot(cor_matrix, method = "color", type = "upper",
tl.col = "black", tl.cex = 0.8,
addCoef.col = "black",
number.cex = 0.7,
main = "Correlation Matrix of Numeric Features",
mar = c(0, 0, 2, 0))
# Load GGally for pair plots
library(GGally)
# Create a scatterplot matrix (pair plot)
ggpairs(PimaIndiansDiabetes2, columns = 1:5, aes(color = diabetes),
title = "Scatterplot Matrix of Select Features Colored by Diabetes Status")
# Density plot of glucose levels
ggplot(PimaIndiansDiabetes2, aes(x = glucose, fill = diabetes)) +
geom_density(alpha = 0.6) +
labs(title = "Density Plot of Glucose Levels by Diabetes Status", x = "Glucose Level") +
scale_fill_manual(values = c("steelblue", "tomato"))
# Density plot of insulin levels
ggplot(PimaIndiansDiabetes2, aes(x = insulin, fill = diabetes)) +
geom_density(alpha = 0.6) +
labs(title = "Density Plot of Insulin Levels by Diabetes Status", x = "Insulin Level") +
scale_fill_manual(values = c("steelblue", "tomato"))
# Random forest model for feature importance
library(randomForest)
# Random forest model for feature importance
library(randomForest)
# Random forest model for feature importance
install.packages("randomForest")
library(randomForest)
rf_model <- randomForest(diabetes ~ glucose + insulin + mass + pregnant + pressure + triceps + age + pedigree,
data = PimaIndiansDiabetes2, importance = TRUE)
# Extract and plot feature importance
importance_df <- data.frame(Feature = rownames(importance(rf_model)),
Importance = importance(rf_model)[,1])
# Create a bar plot of feature importance
ggplot(importance_df, aes(x = reorder(Feature, Importance), y = Importance)) +
geom_bar(stat = "identity", fill = "dodgerblue") +
coord_flip() +
labs(title = "Feature Importance from Random Forest Model", x = "Feature", y = "Importance")
# Boxplot of glucose levels with jitter for actual data points
ggplot(PimaIndiansDiabetes2, aes(x = diabetes, y = glucose, color = diabetes)) +
geom_boxplot() +
geom_jitter(width = 0.2, alpha = 0.5) +
labs(title = "Boxplot of Glucose Levels by Diabetes Status", x = "Diabetes", y = "Glucose Level") +
theme_minimal()
# ROC curve for decision tree classifier
y_prob <- predict(clf, X, type = "prob")[,2]  # Get predicted probabilities for class 1
# ROC curve for decision tree classifier
y_prob <- predict(rf_model, X, type = "prob")[,2]  # Get predicted probabilities for class 1
roc_curve <- roc(y_true, y_prob)
# Plot ROC curve
plot(roc_curve, col = "blue", main = "ROC Curve for Diabetes Classification")
auc_val <- auc(roc_curve)
text(0.6, 0.4, paste("AUC =", round(auc_val, 3)), col = "red", cex = 1.2)
# Violin plot for glucose by diabetes status
ggplot(PimaIndiansDiabetes2, aes(x = diabetes, y = glucose, fill = diabetes)) +
geom_violin(trim = FALSE) +
labs(title = "Violin Plot of Glucose by Diabetes Status", x = "Diabetes", y = "Glucose Level") +
scale_fill_manual(values = c("steelblue", "tomato"))
