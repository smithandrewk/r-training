library(tidyverse)
help(data)
data("mtcars")
force(VADeaths)
force(mtcars)
View(mtcars)
filtered_data <- mtcars %>%
filter(mpg > 20)
View(filtered_data)
mutated_data <- filtered_data %>%
mutate(weight_kg = wt * 453.592)
View(mutated_data)
selected_data <- mutated_data %>%
select(mpg, cyl, weight_kg)
View(selected_data)
summary_data <- selected_data %>%
group_by(cyl) %>%
summarize(avg_mpg = mean(mpg))
View(summary_data)
ggplot(mtcars, aes(x = wt, y = mpg)) +
geom_point() +
labs(title = "Scatter plot of MPG vs. Weight", x = "Weight (1000 lbs)", y = "Miles per Gallon")
ggplot(mtcars, aes(x = wt, y = mpg, color = factor(cyl))) +
geom_point(size = 3) +
geom_smooth(method = "lm", se = FALSE) +
labs(title = "MPG vs. Weight with Cylinders as Color", color = "Cylinders")
wide_data <- data.frame(
id = 1:3,
height = c(150, 160, 170),
weight = c(60, 70, 80)
)
View(wide_data)
long_data <- wide_data %>%
gather(key = "measurement", value = "value", height, weight)
View(long_data)
separated_data <- long_data %>%
separate(id, into = c("group", "subject"), sep = 1)
View(separated_data)
# Example: A dataset in wide format
wide_data <- data.frame(
id = c("group1_subject1", "group2_subject2", "group3_subject3"),
height = c(150, 160, 170),
weight = c(60, 70, 80)
)
# Gather data into long format
long_data <- wide_data %>%
gather(key = "measurement", value = "value", height, weight)
# Separate a column into multiple columns
separated_data <- wide_data %>%
separate(id, into = c("group", "subject"), sep = "_")
# Unite multiple columns into one
united_data <- separated_data %>%
unite("group_subject", group, subject, sep = "-")
View(separated_data)
View(united_data)
write_csv(mtcars,'out.csv')
